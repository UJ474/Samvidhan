{
  "name": "@samvidhan/desktop",
  "version": "1.0.0",
  "description": "Samvidhan — Interactive Constitution of India App",
  "author": "Utkarsh Jain",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "prebuild": "rm -rf web && mkdir -p web && cp -r ../web/dist web/dist",
    "build": "pnpm run prebuild",
    "predist": "pnpm run prebuild",
    "dist": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "in.gov.samvidhan.app",
    "productName": "Samvidhan",
    "mac": {
      "category": "public.app-category.education",
      "target": ["dmg"],
      "identity": null
    },
    "files": [
      "src/**",
      "web/**"
    ]
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8"
  }
}
